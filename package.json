{
  "name": "@dhr2333/dsh-ledger",
  "version": "0.3.2",
  "type": "module",
  "description": "本地、纯文本、复式的 DSH 账本面板（Beancount）：Agent 提案，你审批和对账。",
  "license": "MIT",
  "author": "dhr2333",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhr2333/dsh-ledger.git"
  },
  "homepage": "https://github.com/dhr2333/dsh-ledger#readme",
  "bugs": {
    "url": "https://github.com/dhr2333/dsh-ledger/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "beancount",
    "ledger",
    "reconciliation",
    "bookkeeping",
    "plain-text-accounting",
    "double-entry"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "docs/DETAIL.md",
    "icon.svg",
    "index.js",
    "locale",
    "README.md",
    "scripts/check-bundle.mjs",
    "scripts/vendor.mjs",
    "src",
    "vendor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "optionalDependencies": {
    "@dhr2333/dsh-ledger-runtime-win32-x64": "0.3.2",
    "@dhr2333/dsh-ledger-runtime-win32-arm64": "0.3.2",
    "@dhr2333/dsh-ledger-runtime-darwin-x64": "0.3.2",
    "@dhr2333/dsh-ledger-runtime-darwin-arm64": "0.3.2",
    "@dhr2333/dsh-ledger-runtime-linux-x64": "0.3.2",
    "@dhr2333/dsh-ledger-runtime-linux-arm64": "0.3.2"
  },
  "scripts": {
    "check": "node scripts/check-bundle.mjs",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "runtime:build": "node scripts/build-runtime.mjs --all",
    "runtime:verify": "node scripts/check-pack.mjs",
    "runtime:pack": "node scripts/build-runtime.mjs --all --pack && node scripts/check-pack.mjs",
    "runtime:smoke": "node scripts/smoke-runtime.mjs",
    "prepack": "node scripts/vendor.mjs"
  }
}
