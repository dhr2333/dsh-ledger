{
  "name": "@dhr2333/dsh-ledger",
  "version": "0.2.2",
  "type": "module",
  "description": "Local-first Beancount ledger panel for DSH: AI proposes, you approve and reconcile.",
  "license": "MIT",
  "author": "dhr2333",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhr2333/dsh-ledger.git"
  },
  "homepage": "https://github.com/dhr2333/dsh-ledger#readme",
  "bugs": {
    "url": "https://github.com/dhr2333/dsh-ledger/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "beancount",
    "ledger",
    "reconciliation",
    "bookkeeping"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "docs/DETAIL.md",
    "icon.svg",
    "index.js",
    "locale",
    "README.md",
    "scripts/check-bundle.mjs",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node scripts/check-bundle.mjs"
  }
}
